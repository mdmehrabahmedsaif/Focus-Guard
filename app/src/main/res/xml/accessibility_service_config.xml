<?xml version="1.0" encoding="utf-8"?>
<!--
    Focus Guard Accessibility Service Configuration
    
    EVENT TYPE SELECTION RATIONALE:
    
    typeViewClicked         - Catches user tap at the moment of click (pre-screen-load detection)
    typeWindowStateChanged  - Catches when a new activity/dialog appears (fallback for navigation)
    typeWindowContentChanged- Catches when content updates within a window (for WhatsApp/YouTube tabs)
    
    WHY NOT typeAllMask:
    typeAllMask floods the service with hundreds of events per second (scroll, hover, focus, etc.)
    This wastes CPU, drains battery, and increases ANR risk on low-end devices.
    We only need the 3 event types above for our use cases.
    
    notificationTimeout="0":
    Forces the system to deliver events to our service immediately with zero batching delay.
    Default is 100ms which is too slow for sub-0.1s perception requirement.
    
    canRetrieveWindowContent="true":
    Required for getRootInActiveWindow() and findAccessibilityNodeInfosByText()
    
    flagIncludeNotImportantViews="true":
    Required to detect accessibility items in settings which are sometimes
    marked as not important for accessibility by OEMs (Samsung, Xiaomi)
    
    flagReportViewIds="true":
    Allows us to match view IDs in addition to text for more precise detection
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewClicked|typeWindowStateChanged|typeWindowContentChanged|typeViewHoverEnter|typeViewFocused|typeViewSelected"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagIncludeNotImportantViews|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="0"
    android:description="@string/accessibility_description" />
